{
  "name": "NevaVis (Java 21 + Gradle)",
  "image": "mcr.microsoft.com/devcontainers/java:1-21-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "installGradle": true,
      "gradleVersion": "8.12"
    }
  },
  "postCreateCommand": "bash scripts/build.sh --setup-only",
  "customizations": {
    "vscode": {
      "extensions": ["vscjava.vscode-java-pack", "vscjava.vscode-gradle"]
    }
  }
}
